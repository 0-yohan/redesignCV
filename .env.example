# Optional, for local testing only: a fallback key used when the page has none.
# Leave it unset on a public server so every user must enter their own key on the page.
ANTHROPIC_API_KEY=
# Optional: model to use (default claude-sonnet-5). Use claude-opus-5 for the most careful ratings.
CLAUDE_MODEL=claude-sonnet-5
# Optional: shared password the team must type in the app (recommended once it is online)
APP_PASSWORD=
# Optional: port (default 3000)
PORT=3000
